---
import '../styles/global.css';
import AmbientBackground from '../components/ui/AmbientBackground.astro';
import { profileData } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profileData.name} — ${profileData.shortRole} | Portafolio`,
  description = profileData.heroDescription,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://georgecastillo.dev');
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link id="site-favicon" rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/svg+xml" href="/favicon-light.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />

    <!-- Zero-FOUC Theme Initialization Script -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var isDark = stored === 'dark' || (!stored && prefersDark);
          var root = document.documentElement;
          var favicon = document.getElementById('site-favicon');
          if (isDark) {
            root.classList.add('dark');
            root.setAttribute('data-theme', 'dark');
            if (favicon) favicon.setAttribute('href', '/favicon-dark.svg');
          } else {
            root.classList.remove('dark');
            root.setAttribute('data-theme', 'light');
            if (favicon) favicon.setAttribute('href', '/favicon-light.svg');
          }
        } catch (e) {}
      })();
    </script>

    <!-- SEO & Canonical -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="author" content={profileData.name} />
    <meta id="theme-color-meta" name="theme-color" content="#F2F3FA" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={profileData.name} />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="relative min-h-screen text-slate-900 dark:text-slate-100 selection:bg-violet-500/20 dark:selection:bg-violet-400/30 selection:text-violet-950 dark:selection:text-white">
    <!-- Skip to content link for keyboard accessibility -->
    <a
      href="#home"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-full focus:bg-slate-900 dark:focus:bg-violet-600 focus:px-5 focus:py-2.5 focus:text-sm focus:font-semibold focus:text-white"
    >
      Saltar al contenido principal
    </a>

    <!-- Fixed ambient blobs + iridescent 3D spheres matching reference -->
    <AmbientBackground />

    <!-- Page Wrapper -->
    <div class="relative z-10 mx-auto max-w-[1220px] px-4 sm:px-6 lg:px-8 pt-4 pb-12">
      <slot />
    </div>
  </body>
</html>

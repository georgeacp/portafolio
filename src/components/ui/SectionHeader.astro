---
import { cn } from '../../lib/utils';

interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  class?: string;
}

const { eyebrow, title, subtitle, class: className } = Astro.props;
---

<div class={cn('flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-7 sm:mb-8', className)}>
  <div>
    <p class="text-[11px] sm:text-xs font-bold uppercase tracking-[0.2em] text-violet-600 dark:text-violet-400 mb-2">
      {eyebrow}
    </p>
    <h2 class="text-2xl sm:text-3xl lg:text-[32px] font-extrabold tracking-[-0.03em] text-slate-900 dark:text-white leading-tight">
      {title}
    </h2>
    {subtitle && (
      <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-300 max-w-2xl leading-relaxed">
        {subtitle}
      </p>
    )}
  </div>
  <div class="shrink-0">
    <slot name="action" />
  </div>
</div>

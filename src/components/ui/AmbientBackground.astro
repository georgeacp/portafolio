---
// AmbientBackground.astro
// Recreates the soft lavender/pearl gradient blobs in light mode and cosmic obsidian-violet nebulae in dark mode
---

<div
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 -z-10 overflow-hidden select-none"
>
  <!-- Top-left soft pearl-violet wash -->
  <div
    class="absolute -top-32 -left-32 h-[540px] w-[540px] rounded-full bg-gradient-to-br from-violet-300/35 via-indigo-200/25 to-transparent dark:from-violet-600/25 dark:via-indigo-600/15 blur-[110px]"
  ></div>

  <!-- Top-right hero behind-avatar violet/blue aura -->
  <div
    class="absolute top-12 right-[6%] h-[620px] w-[620px] rounded-full bg-gradient-to-bl from-violet-400/35 via-indigo-300/30 to-sky-200/25 dark:from-violet-600/30 dark:via-indigo-500/22 dark:to-sky-500/15 blur-[120px]"
  ></div>

  <!-- Mid-page subtle lavender cloud -->
  <div
    class="absolute top-[42%] left-[12%] h-[500px] w-[500px] rounded-full bg-gradient-to-tr from-indigo-200/30 via-purple-200/25 to-transparent dark:from-indigo-600/20 dark:via-purple-600/15 blur-[120px]"
  ></div>

  <!-- Bottom-right contact section iridescent glow -->
  <div
    class="absolute bottom-8 right-[4%] h-[520px] w-[520px] rounded-full bg-gradient-to-tl from-violet-400/30 via-indigo-300/25 to-sky-300/20 dark:from-violet-600/25 dark:via-indigo-500/20 dark:to-sky-500/15 blur-[115px]"
  ></div>

  <!-- Decorative 3D Glass Sphere on mid-right -->
  <div
    class="animate-float-slow hidden xl:block absolute top-[38%] -right-10 h-44 w-44 rounded-full opacity-90 dark:opacity-70"
    style="
      background:
        radial-gradient(circle at 30% 28%, rgba(255, 255, 255, 0.98) 0%, rgba(216, 180, 254, 0.65) 22%, rgba(129, 140, 248, 0.45) 52%, rgba(79, 70, 229, 0.35) 76%, rgba(255, 255, 255, 0.8) 100%);
      box-shadow:
        inset -12px -16px 28px rgba(79, 70, 229, 0.3),
        inset 10px 12px 24px rgba(255, 255, 255, 0.9),
        0 28px 50px -12px rgba(79, 70, 229, 0.22);
      border: 1px solid rgba(255, 255, 255, 0.55);
    "
  >
    <div
      class="absolute top-5 left-7 h-10 w-16 -rotate-25 rounded-full bg-white/85 blur-[2px]"
    ></div>
  </div>

  <!-- Subtle diagonal glass light wave streaks -->
  <svg
    class="absolute top-16 right-0 h-[900px] w-[650px] opacity-45 dark:opacity-25"
    viewBox="0 0 650 900"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M650 80C480 180 420 340 520 510C620 680 430 780 260 880"
      stroke="url(#ribbon-grad-1)"
      stroke-width="2.5"
    />
    <path
      d="M680 160C510 260 450 420 550 590C650 760 460 860 290 960"
      stroke="url(#ribbon-grad-2)"
      stroke-width="1.5"
    />
    <defs>
      <linearGradient id="ribbon-grad-1" x1="650" y1="80" x2="260" y2="880" gradientUnits="userSpaceOnUse">
        <stop stop-color="white" stop-opacity="0" />
        <stop offset="0.35" stop-color="#C4B5FD" stop-opacity="0.85" />
        <stop offset="0.7" stop-color="#818CF8" stop-opacity="0.7" />
        <stop offset="1" stop-color="white" stop-opacity="0" />
      </linearGradient>
      <linearGradient id="ribbon-grad-2" x1="680" y1="160" x2="290" y2="960" gradientUnits="userSpaceOnUse">
        <stop stop-color="white" stop-opacity="0" />
        <stop offset="0.5" stop-color="#A78BFA" stop-opacity="0.65" />
        <stop offset="1" stop-color="#93C5FD" stop-opacity="0" />
      </linearGradient>
    </defs>
  </svg>
</div>

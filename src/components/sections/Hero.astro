---
import { profileData } from '../../data/profile';
---

<section id="home" aria-labelledby="hero-heading" class="mb-6">
  <div class="glass-section rounded-[32px] sm:rounded-[36px] px-6 pt-7 pb-0 sm:px-10 sm:pt-10 lg:px-12 lg:pt-12 relative overflow-hidden">
    <!-- Subtle inner top-right violet radial highlight -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -top-20 right-10 h-96 w-96 rounded-full bg-gradient-to-bl from-violet-300/35 via-indigo-200/25 to-transparent dark:from-violet-600/28 dark:via-indigo-500/20 blur-3xl"
    ></div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-6 items-end">
      <!-- Left Column: Intro, Typography, CTAs, Ecosystem Row -->
      <div class="lg:col-span-6 pb-8 sm:pb-10 lg:pb-11 z-10">
        <p class="text-xs sm:text-[13px] font-bold uppercase tracking-[0.2em] text-violet-600 dark:text-violet-400 mb-2.5">
          {profileData.greeting}
        </p>

        <h1
          id="hero-heading"
          class="text-4xl sm:text-5xl lg:text-[58px] font-extrabold tracking-[-0.035em] text-slate-950 dark:text-white leading-[1.04]"
        >
          {profileData.name}
        </h1>

        <p class="mt-1.5 text-2xl sm:text-3xl lg:text-[38px] font-extrabold tracking-[-0.025em] text-role-gradient leading-[1.12]">
          {profileData.heroRoleGradient}
        </p>

        <p class="mt-4 text-sm sm:text-[15.5px] text-slate-600 dark:text-slate-300 max-w-[470px] leading-[1.65]">
          {profileData.heroDescription}
        </p>

        <!-- Primary & Secondary Glass Buttons -->
        <div class="mt-7 flex flex-wrap items-center gap-3.5">
          <a
            href={profileData.primaryCta.href}
            class="btn-primary-dark inline-flex items-center gap-2.5 rounded-full px-6 sm:px-7 py-3.5 text-xs sm:text-[13.5px] font-bold"
          >
            <span>{profileData.primaryCta.label}</span>
            <svg
              class="h-4 w-4 text-white/90"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M7 17L17 7" />
              <path d="M7 7h10v10" />
            </svg>
          </a>

          <a
            href={profileData.secondaryCta.href}
            download
            class="glass-pill hover:bg-white dark:hover:bg-white/16 inline-flex items-center gap-2.5 rounded-full px-6 sm:px-7 py-3.5 text-xs sm:text-[13.5px] font-bold text-slate-800 dark:text-slate-100 transition-all duration-200 hover:-translate-y-0.5"
          >
            <span>{profileData.secondaryCta.label}</span>
            <svg
              class="h-4 w-4 text-slate-600 dark:text-violet-300"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
              <polyline points="7 10 12 15 17 10" />
              <line x1="12" x2="12" y1="15" y2="3" />
            </svg>
          </a>
        </div>

        <!-- Bottom Ecosystem / Trusted Strip -->
        <div class="mt-10 pt-4">
          <p class="text-[11px] font-semibold text-slate-400 dark:text-slate-400 tracking-wide mb-3">
            Especializado en ecosistemas de producción
          </p>
          <div class="flex flex-wrap items-center gap-x-6 gap-y-2.5 text-slate-400/95">
            <span class="inline-flex items-center gap-1.5 text-sm sm:text-[15px] font-bold tracking-tight text-slate-500/80 dark:text-slate-300/80 hover:text-slate-800 dark:hover:text-white transition-colors">
              <svg class="h-4 w-4 text-violet-500/80 dark:text-violet-400" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L3 20h4.5l4.5-9.5L16.5 20H21L12 2zm0 13.5c-1.5 1.2-2.2 2.8-1.5 4.5 1.1-.6 2.1-.6 3 0 .7-1.7 0-3.3-1.5-4.5z"/></svg>
              Astro
            </span>
            <span class="inline-flex items-center gap-1.5 text-sm sm:text-[15px] font-bold tracking-tight text-slate-500/80 dark:text-slate-300/80 hover:text-slate-800 dark:hover:text-white transition-colors">
              <svg class="h-4 w-4 text-indigo-500/80 dark:text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="2.2"/><ellipse rx="10" ry="4.2" transform="matrix(.866 .5 -.5 .866 12 12)"/><ellipse rx="10" ry="4.2" transform="matrix(.866 -.5 .5 .866 12 12)"/></svg>
              React
            </span>
            <span class="inline-flex items-center gap-1.5 text-sm sm:text-[15px] font-bold tracking-tight text-slate-500/80 dark:text-slate-300/80 hover:text-slate-800 dark:hover:text-white transition-colors">
              <svg class="h-4 w-4 text-indigo-500/80 dark:text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 21 7 21 17 12 22 3 17 3 7 12 2"/></svg>
              Node.js
            </span>
            <span class="inline-flex items-center gap-1.5 text-sm sm:text-[15px] font-bold tracking-tight text-slate-500/80 dark:text-slate-300/80 hover:text-slate-800 dark:hover:text-white transition-colors">
              <svg class="h-4 w-4 text-violet-500/80 dark:text-violet-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/></svg>
              AWS Cloud
            </span>
            <span class="inline-flex items-center gap-1.5 text-sm sm:text-[15px] font-bold tracking-tight text-slate-500/80 dark:text-slate-300/80 hover:text-slate-800 dark:hover:text-white transition-colors">
              <svg class="h-4 w-4 text-indigo-500/80 dark:text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></svg>
              PostgreSQL
            </span>
          </div>
        </div>
      </div>

      <!-- Right Column: Organic SVG Glass Contour + Editorial 3/4 Portrait + Floating Metric Cards -->
      <div class="lg:col-span-6 group relative flex justify-center items-end min-h-[390px] sm:min-h-[465px]">
        <!-- Soft Ambient Lavender/Violet Studio Aura behind Portrait -->
        <div
          aria-hidden="true"
          class="pointer-events-none absolute bottom-6 left-1/2 -translate-x-1/2 h-80 w-80 sm:h-[390px] sm:w-[390px] rounded-full bg-gradient-to-tr from-violet-400/35 via-indigo-300/30 to-sky-200/25 dark:from-violet-600/40 dark:via-indigo-500/30 dark:to-sky-400/20 blur-3xl transition-transform duration-700 group-hover:scale-105"
        ></div>

        <!-- Organic Asymmetric SVG Glass Contour (Replicates the exact sloping rounded trapezoid frame behind Aarav Singh) -->
        <svg
          aria-hidden="true"
          viewBox="0 0 480 450"
          fill="none"
          class="pointer-events-none absolute bottom-0 w-[345px] sm:w-[445px] lg:w-[465px] h-auto z-0 transition-transform duration-500 ease-out group-hover:scale-[1.015]"
        >
          <defs>
            <linearGradient id="organicGlassFill" x1="80" y1="30" x2="400" y2="410" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.52" />
              <stop offset="48%" stop-color="#EDE9FE" stop-opacity="0.42" />
              <stop offset="100%" stop-color="#E0E7FF" stop-opacity="0.22" />
            </linearGradient>
            <linearGradient id="organicGlassStroke" x1="90" y1="25" x2="390" y2="390" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.96" />
              <stop offset="55%" stop-color="#FFFFFF" stop-opacity="0.78" />
              <stop offset="100%" stop-color="#C4B5FD" stop-opacity="0.35" />
            </linearGradient>
          </defs>

          <!-- Organic sloping rounded glass shape (wide base, diagonal left slope to sparkle orb, rounded top arc behind hair) -->
          <path
            d="M144 92 C154 46 194 26 248 28 L334 32 C382 34 414 66 422 114 L444 248 C452 298 420 344 368 352 L114 388 C64 394 34 352 48 302 L144 92 Z"
            fill="url(#organicGlassFill)"
            stroke="url(#organicGlassStroke)"
            stroke-width="2.4"
          />
        </svg>

        <!-- Custom 3/4 Editorial Portrait with Organic Feather Mask -->
        <div class="relative z-10 w-[345px] sm:w-[445px] lg:w-[465px] flex justify-center items-end overflow-visible">
          <img
            src="/images/george-avatar.png"
            alt={`${profileData.name} — ${profileData.shortRole}`}
            width="1024"
            height="1024"
            fetchpriority="high"
            decoding="async"
            style="
              -webkit-mask-image: radial-gradient(ellipse 92% 96% at 49% 46%, #000 68%, rgba(0,0,0,0.82) 80%, transparent 99%);
              mask-image: radial-gradient(ellipse 92% 96% at 49% 46%, #000 68%, rgba(0,0,0,0.82) 80%, transparent 99%);
            "
            class="w-full h-auto max-h-[390px] sm:max-h-[455px] object-contain object-bottom select-none drop-shadow-[0_18px_32px_rgba(30,27,75,0.16)] dark:drop-shadow-[0_22px_40px_rgba(0,0,0,0.6)] transition-transform duration-500 ease-out origin-bottom group-hover:scale-[1.02]"
          />
        </div>

        <!-- FLOATING BADGE 1: Top-Right "5+ Years of Experience" Glass Card -->
        <div
          class="animate-float-slow glass-card absolute top-4 right-1 sm:top-7 sm:right-2 lg:right-0 z-20 rounded-2xl px-4 py-3.5 sm:px-5 sm:py-4 text-center min-w-[104px] sm:min-w-[118px] border border-white dark:border-white/20"
        >
          <p class="text-2xl sm:text-3xl font-extrabold tracking-tight bg-gradient-to-b from-slate-800 to-slate-500 dark:from-white dark:to-violet-200 bg-clip-text text-transparent leading-none">
            {profileData.heroFloatingStats.yearsValue}
          </p>
          <p class="mt-1.5 text-[10px] sm:text-[11px] font-medium text-slate-500 dark:text-slate-300 leading-tight">
            {profileData.heroFloatingStats.yearsLabel}
            <strong class="block font-bold text-slate-800 dark:text-white">
              {profileData.heroFloatingStats.yearsSubLabel}
            </strong>
          </p>
        </div>

        <!-- FLOATING BADGE 2: Left Iridescent Sparkle Orb (✦) anchored on the diagonal glass border -->
        <div
          aria-hidden="true"
          class="animate-float-slow-reverse absolute bottom-20 left-2 sm:bottom-24 sm:left-6 lg:left-3 z-20 flex h-14 w-14 sm:h-16 sm:w-16 items-center justify-center rounded-full border border-white/95 dark:border-white/30 shadow-[0_14px_30px_-6px_rgba(124,58,237,0.28),inset_0_2px_6px_rgba(255,255,255,0.95)]"
          style="background: radial-gradient(circle at 32% 28%, rgba(255,255,255,0.98) 0%, rgba(221,214,254,0.82) 55%, rgba(165,180,252,0.75) 100%);"
        >
          <svg
            class="h-6 w-6 text-indigo-500 drop-shadow-xs"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M12 2L14.4 9.6L22 12L14.4 14.4L12 22L9.6 14.4L2 12L9.6 9.6L12 2Z" />
            <path d="M19 3L19.8 5.2L22 6L19.8 6.8L19 9L18.2 6.8L16 6L18.2 5.2L19 3Z" opacity="0.65" />
          </svg>
        </div>

        <!-- FLOATING BADGE 3: Bottom-Right "+120%" Sparkline Glass Card overlapping right shoulder mist -->
        <div
          class="animate-float-slow glass-card absolute bottom-5 right-1 sm:bottom-7 sm:right-2 lg:right-0 z-20 rounded-2xl px-4 py-3 sm:px-5 sm:py-3.5 min-w-[168px] sm:min-w-[198px] border border-white dark:border-white/20"
        >
          <p class="text-[10px] sm:text-[11px] font-semibold text-slate-500 dark:text-slate-300">
            {profileData.heroFloatingStats.impactLabel}
          </p>
          <p class="text-lg sm:text-xl font-extrabold text-slate-950 dark:text-white tracking-tight mt-0.5">
            {profileData.heroFloatingStats.impactValue}
          </p>

          <!-- Smooth ascending SVG sparkline -->
          <svg
            class="mt-1.5 h-7 w-full overflow-visible"
            viewBox="0 0 150 32"
            fill="none"
            aria-hidden="true"
          >
            <defs>
              <linearGradient id="sparklineFill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#8B5CF6" stop-opacity="0.32" />
                <stop offset="100%" stop-color="#8B5CF6" stop-opacity="0" />
              </linearGradient>
              <linearGradient id="sparklineStroke" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#A78BFA" />
                <stop offset="55%" stop-color="#8B5CF6" />
                <stop offset="100%" stop-color="#60A5FA" />
              </linearGradient>
            </defs>
            <path
              d="M2 26 Q 22 19, 38 22 T 74 16 T 110 18 T 144 5 L 144 30 L 2 30 Z"
              fill="url(#sparklineFill)"
            />
            <path
              d="M2 26 Q 22 19, 38 22 T 74 16 T 110 18 T 144 5"
              stroke="url(#sparklineStroke)"
              stroke-width="2.2"
              stroke-linecap="round"
              fill="none"
            />
            <circle cx="144" cy="5" r="3" fill="#6366F1" stroke="white" stroke-width="1.5" />
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

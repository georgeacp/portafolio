---
import { profileData } from '../../data/profile';
---

<section id="contacto" aria-labelledby="contact-heading" class="mb-6">
  <div data-reveal class="glass-section rounded-[32px] sm:rounded-[36px] p-6 sm:p-9 lg:p-11 relative overflow-hidden">
    <!-- Decorative 3D Iridescent Violet-Chrome Sphere on Bottom-Right -->
    <div
      aria-hidden="true"
      class="animate-float-slow-reverse pointer-events-none hidden lg:block absolute -bottom-10 -right-8 h-52 w-52 rounded-full opacity-90 dark:opacity-75"
      style="
        background:
          radial-gradient(circle at 28% 26%, rgba(255, 255, 255, 0.98) 0%, rgba(216, 180, 254, 0.85) 28%, rgba(129, 140, 248, 0.78) 58%, rgba(79, 70, 229, 0.55) 82%, rgba(255, 255, 255, 0.9) 100%);
        box-shadow:
          inset -14px -18px 30px rgba(67, 56, 202, 0.35),
          inset 12px 12px 24px rgba(255, 255, 255, 0.95),
          0 26px 55px -12px rgba(109, 40, 217, 0.28);
        border: 1.5px solid rgba(255, 255, 255, 0.7);
      "
    >
      <div class="absolute top-6 left-9 h-10 w-20 -rotate-20 rounded-full bg-white/85 blur-[2px]"></div>
      <div class="absolute bottom-8 right-10 h-6 w-14 rotate-15 rounded-full bg-sky-200/75 blur-[3px]"></div>
    </div>

    <div class="relative z-10">
      <div>
        <div class="mb-2 flex flex-wrap items-center justify-between gap-x-4 gap-y-3">
          <p class="text-[11px] sm:text-xs font-bold uppercase tracking-[0.2em] text-violet-600 dark:text-violet-400">
            {profileData.contact.eyebrow}
          </p>
          <div class="inline-flex items-center gap-2.5 rounded-full border border-violet-200/80 bg-white/80 px-3.5 py-2 text-[11px] sm:text-xs font-semibold text-slate-700 shadow-[0_8px_22px_-12px_rgba(79,70,229,0.32)] backdrop-blur-sm dark:border-violet-300/20 dark:bg-white/[0.08] dark:text-slate-200">
            <span class="h-2 w-2 rounded-full bg-emerald-500 shadow-[0_0_9px_rgba(16,185,129,0.55)]"></span>
            <span>{profileData.contact.availability}</span>
          </div>
        </div>

          <h2
            id="contact-heading"
            class="text-2xl sm:text-3xl lg:text-[32px] font-extrabold tracking-[-0.03em] text-slate-950 dark:text-white leading-[1.18]"
          >
            <span class="block">{profileData.contact.titleLine1}</span>
            <span class="block">{profileData.contact.titleLine2}</span>
          </h2>

          <p class="mt-3.5 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed max-w-md">
            {profileData.contact.subtitle}
          </p>

          <!-- Direct Contact Rows -->
          <ul class="mt-7 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            <li class="flex items-center gap-3.5">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white/90 dark:bg-white/10 border border-white dark:border-white/20 text-violet-600 dark:text-violet-300 shadow-xs">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              </span>
              <div>
                <p class="text-[11px] font-semibold text-slate-400 dark:text-slate-400">Email directo</p>
                <a
                  href={`mailto:${profileData.contact.email}`}
                  class="text-xs sm:text-sm font-bold text-slate-800 dark:text-slate-100 hover:text-violet-600 dark:hover:text-violet-300 transition-colors"
                >
                  {profileData.contact.email}
                </a>
              </div>
            </li>

            <li class="flex items-center gap-3.5">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white/90 dark:bg-white/10 border border-white dark:border-white/20 text-indigo-600 dark:text-indigo-300 shadow-xs">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </span>
              <div>
                <p class="text-[11px] font-semibold text-slate-400 dark:text-slate-400">Teléfono / WhatsApp</p>
                <a
                  href={`tel:${profileData.contact.phone.replace(/\s+/g, '')}`}
                  class="text-xs sm:text-sm font-bold text-slate-800 dark:text-slate-100 hover:text-violet-600 dark:hover:text-violet-300 transition-colors"
                >
                  {profileData.contact.phone}
                </a>
              </div>
            </li>

            <li class="flex items-center gap-3.5">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white/90 dark:bg-white/10 border border-white dark:border-white/20 text-sky-600 dark:text-sky-300 shadow-xs">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              </span>
              <div>
                <p class="text-[11px] font-semibold text-slate-400 dark:text-slate-400">Ubicación</p>
                <p class="text-xs sm:text-sm font-bold text-slate-800 dark:text-slate-100">
                  {profileData.contact.location}
                </p>
              </div>
            </li>
          </ul>
        </div>

    </div>
  </div>
</section>

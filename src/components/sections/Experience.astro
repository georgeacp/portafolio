---
import { experienceSectionData, experiences, engineeringProcess } from '../../data/experience';
---

<section id="experiencia" aria-labelledby="experience-heading" class="space-y-6 mb-6">
  <!-- PART A: VERTICAL TIMELINE + GLASS CARDS -->
  <div data-reveal class="glass-section rounded-[32px] sm:rounded-[34px] p-6 sm:p-9 lg:p-11">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <p class="text-[11px] sm:text-xs font-bold uppercase tracking-[0.2em] text-violet-600 dark:text-violet-400 mb-1.5">
          {experienceSectionData.eyebrow}
        </p>
        <h2
          id="experience-heading"
          class="text-2xl sm:text-3xl lg:text-[32px] font-extrabold tracking-[-0.03em] text-slate-950 dark:text-white"
        >
          {experienceSectionData.title}
        </h2>
      </div>
      <span class="glass-pill inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-xs font-bold text-violet-700 dark:text-violet-300 self-start sm:self-auto">
        <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
        +5 Años Construyendo Producto
      </span>
    </div>

    <!-- Vertical Timeline Container -->
    <div class="relative pl-5 sm:pl-8 before:absolute before:top-4 before:bottom-4 before:left-[9px] sm:before:left-[13px] before:w-[2px] before:bg-gradient-to-b before:from-violet-500 before:via-indigo-400/70 before:to-slate-200 dark:before:to-white/10">
      <div class="space-y-5 sm:space-y-6" data-reveal-stagger>
        {experiences.map((exp) => (
          <article data-reveal class="relative group">
            <!-- Timeline Node Dot -->
            <div
              aria-hidden="true"
              class={`absolute -left-5 sm:-left-8 top-6 flex h-5 w-5 sm:h-7 sm:w-7 items-center justify-center rounded-full border-2 border-white dark:border-slate-900 shadow-md transition-transform duration-200 group-hover:scale-110 ${
                exp.current
                  ? 'bg-gradient-to-br from-violet-600 to-indigo-600 text-white'
                  : 'bg-white dark:bg-[#1E1A3A] text-violet-600 dark:text-violet-300'
              }`}
            >
              <span class="h-2 w-2 rounded-full bg-current"></span>
            </div>

            <!-- Glass Experience Card -->
            <div class="glass-card glass-card-interactive rounded-2xl sm:rounded-[24px] p-5 sm:p-7 border border-white/95 dark:border-white/14">
              <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-4">
                <!-- Left: Pastel Icon Tile + Role & Company -->
                <div class="flex items-start gap-4">
                  <div
                    class={`hidden sm:flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl border ${exp.accentTheme.iconBg} dark:bg-white/10 dark:border-white/15 ${exp.accentTheme.iconColor} dark:text-violet-300 shadow-xs`}
                  >
                    {exp.iconType === 'architecture' && (
                      <img
                        src="https://rapidboard.app/logo/logo.svg"
                        alt="Logo de RapidBoard"
                        class="h-8 w-8 object-contain"
                        width="32"
                        height="32"
                        loading="lazy"
                      />
                    )}
                    {exp.iconType === 'fullstack' && (
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
                    )}
                    {exp.iconType === 'frontend' && (
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/></svg>
                    )}
                    {exp.iconType === 'cloud' && (
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/></svg>
                    )}
                  </div>

                  <div>
                    <div class="flex flex-wrap items-center gap-2.5">
                      <span class="text-xs font-extrabold tracking-widest text-violet-600/80 dark:text-violet-400">
                        {exp.step}
                      </span>
                      <h3 class="text-lg sm:text-xl font-extrabold tracking-tight text-slate-950 dark:text-white">
                        {exp.role}
                      </h3>
                      {exp.current && (
                        <span class="rounded-full bg-violet-600/12 dark:bg-violet-500/25 border border-violet-500/25 dark:border-violet-400/35 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-violet-700 dark:text-violet-200">
                          Actual
                        </span>
                      )}
                    </div>
                    <p class="mt-1 text-xs sm:text-sm font-semibold text-slate-700 dark:text-slate-300">
                      {exp.company} <span class="text-slate-400 dark:text-slate-400 font-normal">· {exp.location}</span>
                    </p>
                  </div>
                </div>

                <!-- Right: Date Pill Badge -->
                <div class="shrink-0">
                  <span class="inline-flex items-center rounded-full bg-white/90 dark:bg-white/10 border border-white dark:border-white/15 px-3.5 py-1.5 text-xs font-bold text-slate-700 dark:text-slate-200 shadow-2xs">
                    {exp.period}
                  </span>
                </div>
              </div>

              <!-- Description & Achievement Bullets -->
              <p class="mt-4 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                {exp.summary}
              </p>

              <ul class="mt-3.5 space-y-2">
                {exp.highlights.map((bullet) => (
                  <li class="flex items-start gap-2.5 text-xs sm:text-[13.5px] text-slate-600 dark:text-slate-300 leading-relaxed">
                    <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-violet-500 dark:bg-violet-400"></span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>

              <!-- Stack Tags + Bottom-Right Arrow Accent -->
              <div class="mt-5 pt-4 border-t border-slate-200/50 dark:border-white/10 flex flex-wrap items-center justify-between gap-3">
                <div class="flex flex-wrap items-center gap-1.5">
                  {exp.technologies.map((tech) => (
                    <span
                      class={`rounded-full border px-3 py-1 text-[11px] font-bold ${exp.accentTheme.pillBg} ${exp.accentTheme.pillText} dark:bg-violet-500/15 dark:border-violet-400/25 dark:text-violet-200`}
                    >
                      {tech}
                    </span>
                  ))}
                </div>

                <span
                  aria-hidden="true"
                  class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-white/80 dark:bg-white/10 text-slate-500 dark:text-slate-300 group-hover:text-violet-600 dark:group-hover:text-violet-300 group-hover:bg-white dark:group-hover:bg-white/20 transition-colors"
                >
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
                </span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>

  <!-- PART B: 5-STEP PROCESS STRIP -->
  <div data-reveal class="glass-section rounded-[32px] sm:rounded-[34px] p-6 sm:p-9 lg:p-10">
    <div class="mb-6">
      <p class="text-[11px] sm:text-xs font-bold uppercase tracking-[0.2em] text-violet-600 dark:text-violet-400 mb-1.5">
        {experienceSectionData.processEyebrow}
      </p>
      <h3 class="text-2xl sm:text-[28px] font-extrabold tracking-[-0.03em] text-slate-950 dark:text-white">
        {experienceSectionData.processTitle}
      </h3>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3.5 relative" data-reveal-stagger>
      {engineeringProcess.map((proc, idx) => (
        <div data-reveal class="glass-card glass-card-interactive rounded-2xl p-5 border border-white/95 dark:border-white/14 relative flex flex-col justify-between">
          <div class="flex items-center justify-between mb-4">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-violet-500/10 dark:bg-violet-500/20 border border-violet-500/15 dark:border-violet-400/25 text-violet-600 dark:text-violet-300">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 2v3"/><path d="M12 19v3"/><path d="M2 12h3"/><path d="M19 12h3"/></svg>
            </span>
            <span class={`text-xl font-extrabold tracking-tight ${idx === 3 ? 'text-violet-600 dark:text-violet-400' : 'text-slate-400/80 dark:text-slate-500'}`}>
              {proc.step}
            </span>
          </div>
          <div>
            <h4 class="text-sm sm:text-[15px] font-extrabold text-slate-900 dark:text-white mb-1">
              {proc.title}
            </h4>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
              {proc.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

---
import { profileData } from '../../data/profile';
import { skillsSectionData, techSkills } from '../../data/skills';
import astroIcon from 'devicon/icons/astro/astro-original.svg?url';
import reactIcon from 'devicon/icons/react/react-original.svg?url';
import typescriptIcon from 'devicon/icons/typescript/typescript-original.svg?url';
import nodejsIcon from 'devicon/icons/nodejs/nodejs-original.svg?url';
import postgresqlIcon from 'devicon/icons/postgresql/postgresql-original.svg?url';
import dockerIcon from 'devicon/icons/docker/docker-original.svg?url';
import awsIcon from 'devicon/icons/amazonwebservices/amazonwebservices-original-wordmark.svg?url';
import gitIcon from 'devicon/icons/git/git-original.svg?url';
import linuxIcon from 'devicon/icons/linux/linux-original.svg?url';
import tailwindIcon from 'devicon/icons/tailwindcss/tailwindcss-original.svg?url';

const techIcons = {
  astro: astroIcon,
  react: reactIcon,
  typescript: typescriptIcon,
  nodejs: nodejsIcon,
  postgresql: postgresqlIcon,
  docker: dockerIcon,
  aws: awsIcon,
  git: gitIcon,
  linux: linuxIcon,
  tailwind: tailwindIcon,
};
---

<section id="sobre-mi" aria-labelledby="about-heading" class="space-y-6 mb-6">
  <!-- PART A: ABOUT ME GLASS PANEL -->
  <div data-reveal class="glass-section rounded-[32px] sm:rounded-[34px] p-6 sm:p-9 lg:p-11">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
      <!-- Left Half: Eyebrow + 2-Line Title + 3-Metric Inner Glass Strip -->
      <div class="lg:col-span-6">
        <p class="text-[11px] sm:text-xs font-bold uppercase tracking-[0.2em] text-violet-600 dark:text-violet-400 mb-2">
          {profileData.about.eyebrow}
        </p>
        <h2
          id="about-heading"
          class="text-2xl sm:text-3xl lg:text-[34px] font-extrabold tracking-[-0.03em] text-slate-950 dark:text-white leading-[1.16]"
        >
          <span class="block">{profileData.about.titleLine1}</span>
          <span class="block">{profileData.about.titleLine2}</span>
        </h2>

        <!-- 3 Metrics Inner Glass Card (2+, 30+, 15+) -->
        <div class="glass-card mt-6 rounded-2xl p-4 sm:p-5 grid grid-cols-3 gap-3 sm:gap-5 border border-white/95 dark:border-white/15" data-reveal-stagger>
          {profileData.about.metrics.map((metric, idx) => (
            <div data-reveal class={`${idx !== 0 ? 'border-l border-slate-200/70 dark:border-white/10 pl-3 sm:pl-5' : ''}`}>
              <!-- Small tinted icon square -->
              <div class="mb-2.5 inline-flex h-8 w-8 items-center justify-center rounded-lg bg-violet-500/10 dark:bg-violet-500/20 border border-violet-500/15 dark:border-violet-400/25 text-violet-600 dark:text-violet-300">
                {metric.icon === 'experience' && (
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                )}
                {metric.icon === 'projects' && (
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/><path d="m9 14 2 2 4-4"/></svg>
                )}
                {metric.icon === 'clients' && (
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                )}
              </div>
              <p class="text-xl sm:text-2xl font-extrabold tracking-tight text-slate-950 dark:text-white">
                {metric.value}
              </p>
              <p class="mt-0.5 text-[11px] sm:text-xs font-medium text-slate-500 dark:text-slate-400 leading-snug">
                {metric.label}
              </p>
            </div>
          ))}
        </div>
      </div>

      <!-- Right Half: Bio Copy + Secondary Glass Pill CTA -->
      <div class="lg:col-span-6 lg:pl-4">
        <div class="space-y-3.5 text-sm sm:text-[15px] text-slate-600 dark:text-slate-300 leading-[1.7]">
          <p>
            Soy un desarrollador Full Stack con <strong class="font-semibold text-slate-900 dark:text-white">2+ años de experiencia</strong> transformando problemas técnicos complejos en plataformas digitales simples, intuitivas y <strong class="font-semibold text-slate-900 dark:text-white">listas para escalar en producción</strong>.
          </p>
          <p>
            Creo en la ingeniería centrada en las personas, las <strong class="font-semibold text-slate-900 dark:text-white">arquitecturas limpias</strong> y el cuidado por los <strong class="font-semibold text-slate-900 dark:text-white">detalles invisibles</strong> que hacen que un software se sienta extraordinario.
          </p>
        </div>

        <div class="mt-6">
          <a
            href={profileData.about.ctaHref}
            class="glass-pill hover:bg-white dark:hover:bg-white/16 inline-flex items-center gap-2.5 rounded-full px-6 py-3 text-xs sm:text-[13px] font-bold text-slate-900 dark:text-white transition-all duration-200 hover:-translate-y-0.5"
          >
            <span>{profileData.about.ctaLabel}</span>
            <svg
              class="h-3.5 w-3.5 text-slate-700 dark:text-violet-300"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M7 17L17 7" />
              <path d="M7 7h10v10" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- PART B: TECHNOLOGIES I USE GLASS PANEL -->
  <div data-reveal class="glass-section rounded-[32px] sm:rounded-[34px] p-6 sm:p-9 lg:p-10">
    <div class="mb-6">
      <p class="text-[11px] sm:text-xs font-bold uppercase tracking-[0.2em] text-violet-600 dark:text-violet-400 mb-1.5">
        {skillsSectionData.eyebrow}
      </p>
      <h3 class="text-2xl sm:text-[28px] font-extrabold tracking-[-0.03em] text-slate-950 dark:text-white">
        {skillsSectionData.title}
      </h3>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-5 lg:grid-cols-10 gap-3 sm:gap-3.5" data-reveal-stagger>
      {techSkills.map((skill) => (
        <div data-reveal
          class="glass-card glass-card-interactive tech-skill-card group flex flex-col items-center justify-center rounded-2xl py-4 px-3 text-center border border-white/95 dark:border-white/14"
        >
          <div class="tech-skill-icon mb-2.5 flex h-11 w-11 items-center justify-center rounded-xl bg-white/95 ring-1 ring-slate-200/70 shadow-[0_8px_18px_-4px_rgba(15,23,42,0.16)] transition-transform duration-200 group-hover:scale-108">
            <img src={techIcons[skill.iconKey]} alt="" width="28" height="28" class="h-7 w-7 object-contain" loading="lazy" decoding="async" />
          </div>
          <span class="text-xs font-bold text-slate-800 dark:text-slate-100">{skill.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>
